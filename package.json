{
  "name": "tendshare",
  "version": "0.0.0",
  "private": true,
  "description": "Tendshare \u2014 the calm, shared home for a family caring for someone they love.",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @tendshare/app dev:web",
    "ios": "pnpm --filter @tendshare/app ios",
    "android": "pnpm --filter @tendshare/app android",
    "typecheck": "tsc --noEmit -p tsconfig.json && turbo run typecheck",
    "lint": "turbo run lint && eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rls": "vitest run --config vitest.rls.config.ts",
    "test:rls:local": "node scripts/rls-local.mjs",
    "test:auth:live": "vitest run --config vitest.auth.config.ts",
    "db:migrate": "node scripts/db-migrate.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@supabase/supabase-js": "^2.118.0",
    "@tendshare/config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "pg": "^8.23.1",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
