{
  "extends": [
    "expo/tsconfig.base",
    "@tendshare/config/tsconfig/base.json"
  ],
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "types": [
      "node"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".expo"
  ]
}
